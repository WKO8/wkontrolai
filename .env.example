# ==========================================
# WKontrolAI Environment Variables Template
# ==========================================

# 1. Aplicação & Domínio
# Em desenvolvimento local use: http://localhost:3000
# Em produção use o seu domínio público (ex: https://app.exemplo.com)
NODE_ENV=production
APP_DOMAIN=app.exemplo.com
NEXT_PUBLIC_APP_URL=https://app.exemplo.com

# 2. Banco de Dados PostgreSQL 16 (Dedicado ao WKontrolAI)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=coloque_uma_senha_forte_aqui
POSTGRES_DB=wkontrolai
DATABASE_URL=postgres://postgres:coloque_uma_senha_forte_aqui@postgres:5432/wkontrolai

# 3. Cache & Filas Redis 7 (Dedicado ao WKontrolAI)
REDIS_URL=redis://redis:6379

# 4. WhatsApp Engine (Evolution API v2) & Configuração do Bot
# URL interna de comunicação com a Evolution API (ex: http://host.docker.internal:8080 ou http://evolution-api:8080)
EVOLUTION_API_URL=http://host.docker.internal:8080
EVOLUTION_API_KEY=sua_evolution_api_global_key_existente
EVOLUTION_INSTANCE_NAME=wkontrol_bot
EVOLUTION_WEBHOOK_SECRET=segredo_para_validar_assinatura_webhook
EVOLUTION_BOT_PHONE=5511999999999
NEXT_PUBLIC_BOT_PHONE=5511999999999

# 5. Modelos de Inteligência Artificial
# Jev (TypeSafe AI System One - Decisões booleanas noul e classificação choice)
# Docs: https://docs.typesafe.ai/introduction
TYPESAFE_API_KEY=seu_typesafe_api_key_aqui

# Groq Cloud API (Whisper-large-v3 para transcrição de áudios em <400ms)
GROQ_API_KEY=seu_groq_api_key_aqui

# DeepSeek API (V3 / Multimodal Vision para extração de comprovantes e análises profundas)
DEEPSEEK_API_KEY=seu_deepseek_api_key_aqui

# 6. E-mails Transacionais & Autenticação
RESEND_API_KEY=re_seu_resend_api_key_aqui
EMAIL_FROM=WKontrolAI <nao-responda@seudominio.com>

# Google OAuth (PWA Login)
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# JWT & Segredo de Sessão
AUTH_SECRET=gere_uma_chave_aleatoria_com_openssl_rand_base64_32
